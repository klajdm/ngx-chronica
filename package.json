{
  "name": "nga-inline-calendar",
  "version": "1.1.1",
  "description": "A lightweight, customizable inline calendar component for Angular applications",
  "main": "dist/nga-inline-calendar/index.js",
  "types": "dist/nga-inline-calendar/index.d.ts",
  "files": [
    "dist/nga-inline-calendar",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "ng build nga-inline-calendar",
    "build:app": "ng build angular-inline-calendar --configuration=production",
    "build:watch": "ng build nga-inline-calendar --watch",
    "test": "ng test nga-inline-calendar",
    "test:ci": "ng test nga-inline-calendar --browsers=ChromeHeadless --watch=false --code-coverage",
    "lint": "ng lint nga-inline-calendar",
    "pack": "npm run build && npm pack dist/nga-inline-calendar",
    "publish:npm": "npm run build && npm publish dist/nga-inline-calendar"
  },
  "keywords": [
    "angular",
    "angular-calendar",
    "angular-inline-calendar",
    "calendar",
    "inline-calendar",
    "inline",
    "date-picker",
    "component",
    "ui"
  ],
  "author": "Klajdi Murataj <klajdimurati3@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/klajdm/nga-inline-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/klajdm/nga-inline-calendar/issues"
  },
  "homepage": "https://nga-inline-calendar.vercel.app",
  "peerDependencies": {
    "@angular/common": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@angular/core": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/animations": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.7.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^17.0.0",
    "typescript": "~5.2.0",
    "zone.js": "^0.14.10"
  }
}
