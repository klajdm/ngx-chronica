{
  "name": "ngx-chronica",
  "version": "1.0.0",
  "description": "A lightweight, customizable inline calendar component for Angular applications",
  "main": "dist/chronica/index.js",
  "types": "dist/chronica/index.d.ts",
  "files": [
    "dist/chronica",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "ng build chronica",
    "build:app": "ng build chronica --configuration=production",
    "build:watch": "ng build chronica --watch",
    "test": "ng test chronica",
    "test:ci": "ng test chronica --browsers=ChromeHeadless --watch=false --code-coverage",
    "lint": "ng lint chronica",
    "pack": "npm run build && npm pack dist/chronica",
    "publish:npm": "npm run build && npm publish dist/chronica"
  },
  "keywords": [
    "angular",
    "angular-calendar",
    "chronica",
    "calendar",
    "inline-calendar",
    "inline",
    "date-picker",
    "component",
    "ui"
  ],
  "author": "Klajdi Murataj <klajdimurati3@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/klajdm/ngx-chronica.git"
  },
  "bugs": {
    "url": "https://github.com/klajdm/ngx-chronica/issues"
  },
  "homepage": "https://ngx-chronica.vercel.app",
  "peerDependencies": {
    "@angular/common": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@angular/core": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^20.0.4",
    "@angular/common": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@angular/compiler": "^20.0.5",
    "@angular/core": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
    "@angular/forms": "^20.0.5",
    "@angular/platform-browser": "^20.0.5",
    "@angular/platform-browser-dynamic": "^20.0.5",
    "@angular/router": "^20.0.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.1",
    "@angular-eslint/builder": "^20.1.1",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/schematics": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/cli": "^20.3.1",
    "@angular/compiler-cli": "^20.3.0",
    "@smarttools/eslint-plugin-rxjs": "^1.0.20",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.7.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "angular-eslint": "^20.1.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
