{
  "name": "ngx-chronica",
  "version": "1.0.0",
  "description": "Complete Angular date & time component library featuring Calendar, Date Range, Time Picker, and Duration Picker. Fill the gaps in Angular ecosystem with 8 themes and dark mode support.",
  "main": "dist/chronica/index.js",
  "types": "dist/chronica/index.d.ts",
  "files": [
    "dist/chronica",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "ng build chronica-demo --configuration=production",
    "build:lib": "ng build chronica",
    "build:lib:watch": "ng build chronica --watch",
    "test": "ng test chronica",
    "test:ci": "ng test chronica --browsers=ChromeHeadless --watch=false --code-coverage",
    "lint": "ng lint chronica",
    "pack": "npm run build:lib && npm pack dist/chronica",
    "publish:npm": "npm run build:lib && npm publish dist/chronica"
  },
  "keywords": [
    "angular",
    "angular-calendar",
    "chronica",
    "calendar",
    "date-picker",
    "time-picker",
    "duration-picker",
    "date-range",
    "datetime-picker",
    "component",
    "ui",
    "typescript",
    "standalone",
    "forms"
  ],
  "author": "Klajdi Murataj <klajdimurati3@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/klajdm/ngx-chronica.git"
  },
  "bugs": {
    "url": "https://github.com/klajdm/ngx-chronica/issues"
  },
  "homepage": "https://ngx-chronica.vercel.app",
  "devDependencies": {
    "@angular/cdk": "^20.0.4",
    "@angular/common": "^20.0.5",
    "@angular/compiler": "^20.0.5",
    "@angular/core": "^20.0.5",
    "@angular/forms": "^20.0.5",
    "@angular/platform-browser": "^20.0.5",
    "@angular/platform-browser-dynamic": "^20.0.5",
    "@angular/router": "^20.0.5",
    "lucide-angular": "^0.544.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "@angular-devkit/build-angular": "^20.3.1",
    "@angular/cli": "^20.3.1",
    "@angular/compiler-cli": "^20.3.0",
    "@smarttools/eslint-plugin-rxjs": "^1.0.20",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.7.0",
    "angular-eslint": "20.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.1",
    "prettier-eslint": "^16.4.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.8.0",
    "typescript-eslint": "8.40.0",
    "zone.js": "^0.15.1"
  }
}
