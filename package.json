{
  "name": "ngx-chronica",
  "version": "1.2.1",
  "description": "Complete Angular date & time component library featuring Calendar, Date Range, Time Picker, and Duration Picker. Fill the gaps in Angular ecosystem with 8 themes and dark mode support.",
  "main": "dist/chronica/index.js",
  "types": "dist/chronica/index.d.ts",
  "files": [
    "dist/chronica",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "ng build chronica-demo --configuration=production",
    "build:lib": "ng build chronica",
    "build:lib:watch": "ng build chronica --watch",
    "test": "ng test chronica",
    "test:ci": "ng test chronica --browsers=ChromeHeadless --watch=false --code-coverage",
    "lint": "ng lint chronica",
    "pack": "npm run build:lib && npm pack dist/chronica",
    "publish:npm": "npm run build:lib && cd dist/chronica && npm publish --access public"
  },
  "keywords": [
    "angular",
    "angular-calendar",
    "chronica",
    "calendar",
    "date-picker",
    "time-picker",
    "duration-picker",
    "date-range",
    "datetime-picker",
    "component",
    "ui",
    "typescript",
    "standalone",
    "forms"
  ],
  "author": "Klajdi Murataj <klajdimurati3@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klajdm/ngx-chronica.git"
  },
  "bugs": {
    "url": "https://github.com/klajdm/ngx-chronica/issues"
  },
  "homepage": "https://ngx-chronica.vercel.app",
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cdk": "21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/common": "^21.2.11",
    "@angular/compiler": "^21.2.11",
    "@angular/compiler-cli": "^21.2.11",
    "@angular/core": "^21.2.11",
    "@angular/forms": "^21.2.11",
    "@angular/platform-browser": "^21.2.11",
    "@angular/platform-browser-dynamic": "^21.2.11",
    "@angular/router": "^21.2.11",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/jasmine": "6.0.0",
    "@types/node": "25.6.0",
    "angular-eslint": "21.3.1",
    "baseline-browser-mapping": "^2.10.25",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jasmine-core": "6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-packagr": "^21.2.3",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "prettier-eslint": "^16.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.2.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.59.1",
    "zone.js": "^0.16.1"
  },
  "dependencies": {
    "@lucide/angular": "^1.14.0"
  }
}
